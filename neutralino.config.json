{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.nervtimer.desktop",
  "applicationName": "NERV Timer",
  "version": "1.0.0",
  "author": "NERV Timer contributors",
  "description": "NERV-inspired desktop clock, stopwatch, and countdown timer",
  "applicationIcon": "resources/icons/appIcon.png",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit"
  ],
  "modes": {
    "window": {
      "title": "NERV Timer",
      "width": 1080,
      "height": 648,
      "minWidth": 800,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "nerv-timer",
    "resourcesPath": "/resources/",
    "resourcesExclude": ".*\\.d\\.ts$",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.10.0",
    "distributionPath": "/dist",
    "builder": {
      "windows": {
        "targets": [
          {
            "target": "nsis",
            "arch": ["x64"],
            "icon": "./installerassets/windows/app.ico",
            "description": "Desktop clock, stopwatch, and countdown timer",
            "output": "./dist/installers/windows"
          }
        ]
      },
      "linux": {
        "targets": [
          {
            "target": "deb",
            "arch": ["x64"],
            "icon": "./installerassets/linux/app.png",
            "category": "Utility",
            "maintainer": "NERV Timer contributors",
            "description": "Desktop clock, stopwatch, and countdown timer",
            "output": "./dist/installers/debian"
          }
        ]
      }
    }
  }
}
